# ─── Data Coffee Model Hub Environment Configuration ───

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_32_character_nextauth_secret_here
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true

# Azure AI Foundry & Azure OpenAI (RAG Embeddings & LLM)

# Azure AI Foundry & Azure OpenAI (RAG Embeddings & LLM)
AZURE_OPENAI_ENDPOINT=https://data-coffee-persona.openai.azure.com/openai/v1
OPENAI_API_KEY=your_azure_openai_api_key_here

# Google Gemini (Streaming LLM Chat)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Azure AI Search (Vector Store + Hybrid RAG)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your_azure_search_admin_key_here
AZURE_SEARCH_INDEX_NAME=modelhub-documents

# Azure Document Intelligence (OCR)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intel.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_document_intelligence_key_here

# Azure Blob Storage (Document Files)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=modelhub-documents

# Database (Optional / Future)
# DATABASE_URL=postgresql://user:password@localhost:5432/modelhub
